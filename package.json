{
  "name": "art-exeplorer-react",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "jest --config jest.config.cjs",
    "test:watch": "jest --config jest.config.cjs --watch",
    "test:coverage": "jest --config jest.config.cjs --coverage",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx}\" --config .prettierrc.cjs",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx}\" --config .prettierrc.cjs",
    "lint": "eslint src --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint src --ext .ts,.tsx,.js,.jsx --fix",
    "prepare": "husky"
  },
  "engines": {
    "node": "^20.0.0 || >=22.0.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
