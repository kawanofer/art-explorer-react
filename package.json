    "axios": "^1.11.0",
    "lodash": "^4.17.21",
    "moment": "^2.29.4",
    "motion": "^12.23.12",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hot-toast": "^2.4.1",
